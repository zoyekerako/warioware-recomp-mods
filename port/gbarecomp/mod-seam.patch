+    // Zeichenflaeche des Mods: folgt der Fenstergroesse, das Spielbild wird
+    // darin zusammengesetzt. Leer, solange der Mod die Darstellung nicht hat.
+    std::vector<uint8_t> mod_fb;
+    int mod_fb_w = 0, mod_fb_h = 0;
+    auto mod_present = [&]() {
+        int dw = 0, dh = 0, sw = 0, sh = 0;
+        if (!win.drawable_size(&dw, &dh) ||
+            !ww_mod_surface_size(dw, dh, &sw, &sh) || sw < 1 || sh < 1) {
+            win.present(live_fb.data());
+            return;
+        }
+        if (sw != mod_fb_w || sh != mod_fb_h) {
+            if (!win.set_surface_size(sw, sh)) { win.present(live_fb.data()); return; }
+            mod_fb_w = sw; mod_fb_h = sh;
+            mod_fb.assign(static_cast<std::size_t>(sw) * sh * 3u, 0);
+        }
+        ww_mod_compose(live_fb.data(), static_cast<int>(ppu.render_width()),
+                       static_cast<int>(ppu.render_height()),
+                       mod_fb.data(), mod_fb_w, mod_fb_h);
+        win.present(mod_fb.data());
     };
 
